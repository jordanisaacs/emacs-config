+  ghostel--title)
+
+(defun ghostel-terminal-progress ()
+  "Return the last OSC 9;4 progress report as (STATE . VALUE).
+STATE is one of `remove', `set', `error', `indeterminate', or `pause'.
+VALUE is an integer from 0 through 100 or nil."
+  (and ghostel--progress-state
+       (cons ghostel--progress-state ghostel--progress-value)))
