diff --git a/src/GhostelTerm.zig b/src/GhostelTerm.zig
index 15a4a35..e019895 100644
--- a/src/GhostelTerm.zig
+++ b/src/GhostelTerm.zig
@@ -762,6 +762,48 @@ pub const emacs_functions = [_]emacs.FunctionEntry{
             }
         },
     },
+    .{
+        .name = "ghostel--copy-active-screen-text",
+        .arity = .{ 1, 1 },
+        .doc =
+        \\Return the active screen as plain text, excluding scrollback.
+        \\
+        \\(ghostel--copy-active-screen-text TERM)
+        ,
+        .impl = struct {
+            pub fn call(env: emacs.Env, _: isize, args: [*c]emacs.Value) !emacs.Value {
+                const term = env.getUserPtr(Self, args[0]) orelse return error.InvalidTerminalHandle;
+                const options = gt.formatter.Options{
+                    .emit = .plain,
+                    .unwrap = true,
+                    .trim = true,
+                };
+                try term.lockTerm();
+                defer term.unlockTerm();
+
+                const terminal = &term.terminal;
+                if (terminal.rows == 0 or terminal.cols == 0) return env.nil();
+                const screen = terminal.screens.active;
+                const top_left = screen.pages.pin(.{ .active = .{
+                    .x = 0,
+                    .y = 0,
+                } }) orelse return env.nil();
+                const bottom_right = screen.pages.pin(.{ .active = .{
+                    .x = terminal.cols - 1,
+                    .y = terminal.rows - 1,
+                } }) orelse return env.nil();
+
+                var formatter = gt.formatter.ScreenFormatter.init(screen, options);
+                formatter.content = .{ .selection = gt.Selection.init(top_left, bottom_right, false) };
+                var writer = std.Io.Writer.Allocating.init(module_alloc);
+                defer writer.deinit();
+                try formatter.format(&writer.writer);
+                const written = writer.written();
+                if (written.len == 0) return env.nil();
+                return env.makeString(written);
+            }
+        },
+    },
