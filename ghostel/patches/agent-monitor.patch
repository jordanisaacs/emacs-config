+(defun ghostel-active-screen-text ()
+  "Return the active terminal screen as plain text, without scrollback.
+This reads the native terminal model, so it stays current for hidden buffers
+whose Emacs text is waiting for a redraw.  Return an empty string before the
+terminal has been initialized or when the screen is blank."
+  (if ghostel--term
+      (or (ghostel--copy-active-screen-text ghostel--term) "")
+    ""))
+
+(defun ghostel-terminal-title ()
