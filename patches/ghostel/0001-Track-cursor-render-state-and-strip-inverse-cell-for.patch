From b3196b79431b041bef6934f1e491b1b6689b1775 Mon Sep 17 00:00:00 2001
From: Jordan Isaacs <jordan.isaacs@databricks.com>
Date: Wed, 22 Apr 2026 06:43:43 +0000
Subject: [PATCH] Track cursor render state and strip inverse cell for TTY
 Emacs

Pipes cursor blinking and password-input state from the render state
through `ghostel--set-cursor-style', records the latest render state
in buffer-local variables, and factors cursor-type mapping into
`ghostel--cursor-type-from-render-state'.

When libghostty paints the cursor cell as reverse-video (e.g. apps
that hide DECTCEM and draw their own inverse cursor), strip the face
on that cell and force visibility so the outer TTY's hardware cursor
doesn't double-invert into an invisible default cell.
---
 lisp/ghostel.el | 48 +++++++++++++++++++++++++++++++---------
 src/ghostty.zig |  1 +
 src/render.zig  | 59 ++++++++++++++++++++++++++++++++++++++++++++++++-
 3 files changed, 96 insertions(+), 12 deletions(-)

diff --git a/lisp/ghostel.el b/lisp/ghostel.el
index a7f45ad..2653b7c 100644
--- a/lisp/ghostel.el
+++ b/lisp/ghostel.el
@@ -2345,23 +2345,49 @@ Only acts when the buffer has not been manually renamed by the user."
   (when ghostel-set-title-function
     (funcall ghostel-set-title-function title)))
 
-(defun ghostel--set-cursor-style (style visible)
-  "Set the cursor style based on terminal state.
+(defvar-local ghostel--cursor-visible t
+  "Most recent terminal cursor visibility reported by the native module.")
+
+(defvar-local ghostel--cursor-blinking nil
+  "Most recent terminal cursor blinking state reported by the native module.")
+
+(defvar-local ghostel--cursor-password-input nil
+  "Most recent password-input cursor state reported by the native module.")
+
+(defun ghostel--cursor-type-from-render-state
+    (style visible &optional _blinking password-input)
+  "Map Ghostty render state to an Emacs `cursor-type' value.
+STYLE is one of: 0=bar, 1=block, 2=underline, 3=hollow-block.
+VISIBLE is t or nil.  PASSWORD-INPUT forces a visible block cursor,
+matching Ghostty's renderer policy for password fields."
+  (cond
+   (password-input 'box)
+   ((not visible) nil)
+   ((not (ghostel--buffer-focused-p (current-buffer))) 'hollow)
+   (t
+    (pcase style
+      (0 '(bar . 2))
+      (1 'box)
+      (2 '(hbar . 2))
+      (3 'hollow)
+      (_ 'box)))))
+
+(defun ghostel--set-cursor-style
+    (style visible &optional blinking password-input)
+  "Set the cursor style based on terminal render state.
 STYLE is one of: 0=bar, 1=block, 2=underline, 3=hollow-block.
-VISIBLE is t or nil.
+VISIBLE, BLINKING, and PASSWORD-INPUT are booleans from libghostty render
+state.
 Skipped when copy mode is active because copy mode manages its own
 cursor, or when `ghostel-ignore-cursor-change' is non-nil."
+  (setq ghostel--cursor-visible visible
+        ghostel--cursor-blinking blinking
+        ghostel--cursor-password-input password-input)
   (unless (or ghostel--copy-mode-active
               ghostel-ignore-cursor-change)
     (setq cursor-type
-          (if visible
-              (pcase style
-                (0 '(bar . 2))       ; bar
-                (1 'box)             ; block
-                (2 '(hbar . 2))      ; underline
-                (3 'hollow)          ; hollow block
-                (_ 'box))
-            nil))))
+          (ghostel--cursor-type-from-render-state
+           style visible blinking password-input))))
 
 (defun ghostel--update-directory (dir)
   "Update `default-directory' from terminal's OSC 7 report.
diff --git a/src/ghostty.zig b/src/ghostty.zig
index 5af8d9d..49b6964 100644
--- a/src/ghostty.zig
+++ b/src/ghostty.zig
@@ -82,6 +82,7 @@ pub const RS_DATA_COLOR_FOREGROUND = c.GHOSTTY_RENDER_STATE_DATA_COLOR_FOREGROUN
 pub const RS_DATA_CURSOR_VISUAL_STYLE = c.GHOSTTY_RENDER_STATE_DATA_CURSOR_VISUAL_STYLE;
 pub const RS_DATA_CURSOR_VISIBLE = c.GHOSTTY_RENDER_STATE_DATA_CURSOR_VISIBLE;
 pub const RS_DATA_CURSOR_BLINKING = c.GHOSTTY_RENDER_STATE_DATA_CURSOR_BLINKING;
+pub const RS_DATA_CURSOR_PASSWORD_INPUT = c.GHOSTTY_RENDER_STATE_DATA_CURSOR_PASSWORD_INPUT;
 pub const RS_DATA_CURSOR_VIEWPORT_HAS_VALUE = c.GHOSTTY_RENDER_STATE_DATA_CURSOR_VIEWPORT_HAS_VALUE;
 pub const RS_DATA_CURSOR_VIEWPORT_X = c.GHOSTTY_RENDER_STATE_DATA_CURSOR_VIEWPORT_X;
 pub const RS_DATA_CURSOR_VIEWPORT_Y = c.GHOSTTY_RENDER_STATE_DATA_CURSOR_VIEWPORT_Y;
diff --git a/src/render.zig b/src/render.zig
index bfb4651..87b6287 100644
--- a/src/render.zig
+++ b/src/render.zig
@@ -879,6 +879,32 @@ fn positionCursorByCell(env: emacs.Env, term: *Terminal, cx: u16, cy: u16) bool
     return true;
 }
 
+/// Return true when the cell at (`cx`, `cy`) has reverse-video styling.
+/// Used to detect the "app paints its own cursor cell as inverse"
+/// pattern so the caller can strip ghostel's inverse face on that one
+/// cell — otherwise the outer terminal's hardware cursor (which draws
+/// the cell at `point' by reverse-video) double-inverts it into an
+/// invisible default cell.
+///
+/// Re-seeds the row iterator, so callers must not rely on iterator
+/// position after this call.
+fn cursorCellIsInverse(term: *Terminal, cx: u16, cy: u16) bool {
+    if (gt.c.ghostty_render_state_get(term.render_state, gt.RS_DATA_ROW_ITERATOR, @ptrCast(&term.row_iterator)) != gt.SUCCESS) {
+        return false;
+    }
+    var ri: u16 = 0;
+    while (ri <= cy) : (ri += 1) {
+        if (!gt.c.ghostty_render_state_row_iterator_next(term.row_iterator)) return false;
+    }
+    if (gt.c.ghostty_render_state_row_get(term.row_iterator, gt.RS_ROW_DATA_CELLS, @ptrCast(&term.row_cells)) != gt.SUCCESS) {
+        return false;
+    }
+    if (gt.c.ghostty_render_state_row_cells_select(term.row_cells, cx) != gt.SUCCESS) {
+        return false;
+    }
+    return readCellStyle(term.row_cells).inverse;
+}
+
 /// Redraw the terminal into the current Emacs buffer.
 ///
 /// Maintains a "growing buffer" model where the Emacs buffer contains
@@ -1279,14 +1305,20 @@ pub fn redraw(env: emacs.Env, term: *Terminal, force_full_arg: bool) void {
     // Batch-fetch cursor style/visibility (always available).
     var cursor_visible: bool = true;
     var cursor_style: c_int = gt.CURSOR_BLOCK;
+    var cursor_blinking: bool = false;
+    var cursor_password_input: bool = false;
     {
         const cursor_keys = [_]gt.c.GhosttyRenderStateData{
             gt.RS_DATA_CURSOR_VISIBLE,
             gt.RS_DATA_CURSOR_VISUAL_STYLE,
+            gt.RS_DATA_CURSOR_BLINKING,
+            gt.RS_DATA_CURSOR_PASSWORD_INPUT,
         };
         var cursor_values = [_]?*anyopaque{
             @ptrCast(&cursor_visible),
             @ptrCast(&cursor_style),
+            @ptrCast(&cursor_blinking),
+            @ptrCast(&cursor_password_input),
         };
         _ = gt.c.ghostty_render_state_get_multi(term.render_state, cursor_keys.len, &cursor_keys, @ptrCast(&cursor_values), null);
     }
@@ -1307,12 +1339,37 @@ pub fn redraw(env: emacs.Env, term: *Terminal, force_full_arg: bool) void {
         if (!positionCursorByCell(env, term, cx, cy)) {
             env.moveToColumn(@as(i64, cx));
         }
+
+        // When libghostty paints the cursor cell as reverse-video (e.g.
+        // Claude Code hides DECTCEM and draws its own inverse cursor
+        // cell), our applyStyle gives it an :fg/:bg swap against the
+        // frame defaults.  On a TTY Emacs, the outer terminal draws the
+        // hardware cursor by reverse-video'ing the cell under `point',
+        // so the two inversions cancel and the cursor becomes invisible.
+        // Strip the face on that one cell and promote visibility so the
+        // outer terminal's cursor lands on a default-face cell and
+        // renders normally.
+        if (cursorCellIsInverse(term, cx, cy)) {
+            const pt = env.extractInteger(env.point());
+            const pmax = env.extractInteger(env.pointMax());
+            if (pt + 1 <= pmax) {
+                env.putTextProperty(
+                    env.makeInteger(pt),
+                    env.makeInteger(pt + 1),
+                    emacs.sym.face,
+                    env.nil(),
+                );
+            }
+            cursor_visible = true;
+        }
     }
 
-    _ = env.call2(
+    _ = env.call4(
         emacs.sym.@"ghostel--set-cursor-style",
         env.makeInteger(@as(i64, cursor_style)),
         if (cursor_visible) env.t() else env.nil(),
+        if (cursor_blinking) env.t() else env.nil(),
+        if (cursor_password_input) env.t() else env.nil(),
     );
 
     // Update working directory from OSC 7
-- 
2.53.0

