+/// Return true when the cell at (`cx`, `cy`) has reverse-video styling.
+/// Used to detect the "app paints its own cursor cell as inverse"
+/// pattern so the caller can strip ghostel's inverse face on that one
+/// cell — otherwise the outer terminal's hardware cursor (which draws
+/// the cell at `point' by reverse-video) double-inverts it into an
+/// invisible default cell.
+///
+/// Re-seeds the row iterator, so callers must not rely on iterator
+/// position after this call.
+fn cursorCellIsInverse(self: *Self, cx: u16, cy: u16) !bool {
+    try gt.rs.read(self.render_state, gt.RS_DATA_ROW_ITERATOR, &self.row_iterator);
+    var ri: u16 = 0;
+    while (ri <= cy) : (ri += 1) {
+        if (!gt.rs_row_next(self.row_iterator)) return false;
+    }
+    try gt.rs_row.read(self.row_iterator, gt.RS_ROW_DATA_CELLS, &self.row_cells);
+    var col: u16 = 0;
+    while (gt.rs_row_cells_next(self.row_cells)) : (col += 1) {
+        if (col == cx) {
+            const gs = try gt.rs_row_cells.getOpt(gt.Style, self.row_cells, gt.RS_CELLS_DATA_STYLE);
+            if (gs) |style| return style.inverse;
+            return false;
+        }
+    }
+    return false;
+}
