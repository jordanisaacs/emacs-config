diff --git a/src/event_buffer.zig b/src/event_buffer.zig
new file mode 100644
index 0000000..5034674
--- /dev/null
+++ b/src/event_buffer.zig
@@ -0,0 +1,312 @@
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const posix = std.posix;
+
+const FixedArrayList = @import("fixed_array_list.zig").FixedArrayList;
+
+/// Inline capacity of a pooled form block.  Sized to hold a typical event form
+/// (OSC markers, title, pwd) without spilling; a larger form (e.g. an OSC 52
+/// clipboard payload) spills to a one-off heap buffer for that node only.
+pub const form_inline_cap: usize = 512;
+
+/// One complete Lisp event form.  Its bytes live in `inline_buf` when they fit,
+/// otherwise in a heap-backed `big` buffer.  Nodes are pooled and recycled.
+const Form = struct {
+    inline_buf: FixedArrayList(u8, form_inline_cap) = .{},
+    big: ?std.ArrayList(u8) = null,
+    next: ?*Form = null,
+
+    fn bytes(self: *Form) []const u8 {
+        if (self.big) |*b| return b.items;
+        return self.inline_buf.items();
+    }
+
+    fn length(self: *Form) usize {
+        if (self.big) |*b| return b.items.len;
+        return self.inline_buf.len;
+    }
+
+    fn reset(self: *Form, alloc: Allocator) void {
+        if (self.big) |*b| b.deinit(alloc);
+        self.* = .{};
+    }
+};
+
+/// A FIFO of complete Lisp event forms backed by a pool of fixed-size blocks.
+///
+/// Why one form per node: it makes form boundaries intrinsic, so the reader can
+/// drop the backlog *safely* — by freeing whole nodes — without ever truncating
+/// a form whose prefix is already on the wire (which would desync Emacs'
+/// incremental `read-from-string` filter).  Why a pool: the hot path (one small
+/// form, flushed before the next arrives) reuses a single pre-warmed node, so
+/// steady state performs zero heap traffic; nodes are only allocated under
+/// back-pressure and returned to the pool afterward.
+///
+/// Single-producer / single-consumer and not internally synchronized: only the
+/// reader thread touches it (builds + commits forms while parsing, flushes
+/// after releasing term_mutex).
+pub const EventBuffer = struct {
+    alloc: Allocator,
+
+    head: ?*Form = null, // FIFO front: being drained by flushTo()
+    tail: ?*Form = null, // FIFO back
+    head_off: usize = 0, // bytes of `head` already written to the pipe
+    building: ?*Form = null, // form under construction, not yet committed
+
+    pending_forms: usize = 0, // committed, not-fully-flushed forms
+    pending_bytes: usize = 0, // committed, not-yet-flushed bytes
+
+    free: ?*Form = null,
+    free_count: usize = 0,
+
+    /// Free nodes kept warm so the steady state never allocates — the "always
+    /// at least this many in the pool" floor.  Tunable.
+    pub const pool_min: usize = 4;
+    /// Upper bound on retained free nodes; excess is returned to the allocator.
+    pub const pool_max: usize = 16;
+
+    pub const FlushResult = enum { drained, would_block, broken };
+
+    pub fn init(alloc: Allocator) EventBuffer {
+        var self = EventBuffer{ .alloc = alloc };
+        // Pre-warm the pool so the first forms don't allocate.  Best-effort.
+        var i: usize = 0;
+        while (i < pool_min) : (i += 1) {
+            const node = alloc.create(Form) catch break;
+            node.* = .{ .next = self.free };
+            self.free = node;
+            self.free_count += 1;
+        }
+        return self;
+    }
+
+    pub fn deinit(self: *EventBuffer) void {
+        if (self.building) |b| {
+            b.reset(self.alloc);
+            self.alloc.destroy(b);
+            self.building = null;
+        }
+        var node = self.head;
+        while (node) |n| {
+            node = n.next;
+            n.reset(self.alloc);
+            self.alloc.destroy(n);
+        }
+        var fnode = self.free;
+        while (fnode) |n| {
+            fnode = n.next;
+            self.alloc.destroy(n);
+        }
+        self.head = null;
+        self.tail = null;
+        self.free = null;
+        self.free_count = 0;
+    }
+
+    pub fn isEmpty(self: *const EventBuffer) bool {
+        return self.pending_forms == 0;
+    }
+    pub fn pendingForms(self: *const EventBuffer) usize {
+        return self.pending_forms;
+    }
+    pub fn pendingBytes(self: *const EventBuffer) usize {
+        return self.pending_bytes;
+    }
+
+    fn acquire(self: *EventBuffer) !*Form {
+        if (self.free) |node| {
+            self.free = node.next;
+            self.free_count -= 1;
+            node.* = .{};
+            return node;
+        }
+        const node = try self.alloc.create(Form);
+        node.* = .{};
+        return node;
+    }
+
+    fn recycle(self: *EventBuffer, node: *Form) void {
+        node.reset(self.alloc);
+        if (self.free_count < pool_max) {
+            node.next = self.free;
+            self.free = node;
+            self.free_count += 1;
+        } else {
+            self.alloc.destroy(node);
+        }
+    }
+
+    /// Begin a new form.  Pair with endForm() (commit) or abortForm() (discard).
+    pub fn beginForm(self: *EventBuffer) !void {
+        std.debug.assert(self.building == null);
+        self.building = try self.acquire();
+    }
+
+    /// Append bytes to the form under construction, spilling to a heap buffer if
+    /// it outgrows the inline block.
+    pub fn appendToForm(self: *EventBuffer, data: []const u8) !void {
+        const node = self.building orelse return error.NoFormInProgress;
+        if (node.big) |*b| {
+            try b.appendSlice(self.alloc, data);
+            return;
+        }
+        // FixedArrayList.appendSlice is all-or-nothing, so on overflow the
+        // inline contents are untouched and safe to copy into the heap buffer.
+        node.inline_buf.appendSlice(data) catch {
+            var b = std.ArrayList(u8){};
+            errdefer b.deinit(self.alloc);
+            try b.appendSlice(self.alloc, node.inline_buf.items());
+            try b.appendSlice(self.alloc, data);
+            node.big = b;
+            node.inline_buf = .{};
+        };
+    }
+
+    /// Commit the form under construction to the FIFO.
+    pub fn endForm(self: *EventBuffer) void {
+        const node = self.building orelse return;
+        self.building = null;
+        node.next = null;
+        if (self.tail) |t| {
+            t.next = node;
+        } else {
+            self.head = node;
+            self.head_off = 0;
+        }
+        self.tail = node;
+        self.pending_forms += 1;
+        self.pending_bytes += node.length();
+    }
+
+    /// Discard the form under construction (e.g. on a build error).
+    pub fn abortForm(self: *EventBuffer) void {
+        if (self.building) |node| {
+            self.recycle(node);
+            self.building = null;
+        }
+    }
+
+    /// Append a complete form in one call.
+    pub fn pushForm(self: *EventBuffer, data: []const u8) !void {
+        try self.beginForm();
+        errdefer self.abortForm();
+        try self.appendToForm(data);
+        self.endForm();
+    }
+
+    /// Write as many whole committed forms as the fd accepts without blocking.
+    /// Never writes the in-progress `building` form, so Emacs only ever sees
+    /// complete forms.  Unsent bytes stay buffered for the next call (POLLOUT).
+    pub fn flushTo(self: *EventBuffer, fd: posix.fd_t) FlushResult {
+        while (self.head) |node| {
+            const slice = node.bytes()[self.head_off..];
+            if (slice.len != 0) {
+                const n = posix.write(fd, slice) catch |err| switch (err) {
+                    error.WouldBlock => return .would_block,
+                    else => return .broken,
+                };
+                if (n == 0) return .would_block;
+                self.head_off += n;
+                self.pending_bytes -= n;
+            }
+            if (self.head_off < node.length()) return .would_block;
+            self.head = node.next;
+            if (self.head == null) self.tail = null;
+            self.head_off = 0;
+            self.pending_forms -= 1;
+            self.recycle(node);
+        }
+        return .drained;
+    }
+
+    /// Drop the backlog.  If the head form's prefix is already on the wire it is
+    /// kept (so Emacs receives a complete form and its reader stays in sync);
+    /// every form after it is discarded.  The grid is authoritative, so the
+    /// caller pokes a redraw afterward when the buffer ends up empty.
+    pub fn dropToInflight(self: *EventBuffer) void {
+        if (self.head == null) return;
+        if (self.head_off > 0) {
+            const keep = self.head.?;
+            var node = keep.next;
+            while (node) |n| {
+                node = n.next;
+                self.recycle(n);
+            }
+            keep.next = null;
+            self.tail = keep;
+            self.pending_forms = 1;
+            self.pending_bytes = keep.length() - self.head_off;
+        } else {
+            self.clear();
+        }
+    }
+
+    /// Discard every committed form unconditionally (used when the pipe breaks).
+    pub fn clear(self: *EventBuffer) void {
+        var node = self.head;
+        while (node) |n| {
+            node = n.next;
+            self.recycle(n);
+        }
+        self.head = null;
+        self.tail = null;
+        self.head_off = 0;
+        self.pending_forms = 0;
+        self.pending_bytes = 0;
+    }
+};
+
+test "EventBuffer: forms flush in order" {
+    const fds = try posix.pipe();
+    defer posix.close(fds[0]);
+    defer posix.close(fds[1]);
+
+    var buf = EventBuffer.init(std.testing.allocator);
+    defer buf.deinit();
+
+    try buf.pushForm("(a)");
+    try buf.pushForm("(b)");
+    try std.testing.expectEqual(EventBuffer.FlushResult.drained, buf.flushTo(fds[1]));
+    try std.testing.expect(buf.isEmpty());
+
+    var out: [32]u8 = undefined;
+    const n = try posix.read(fds[0], &out);
+    try std.testing.expectEqualStrings("(a)(b)", out[0..n]);
+}
+
+test "EventBuffer: large form spills to heap and round-trips" {
+    const fds = try posix.pipe();
+    defer posix.close(fds[0]);
+    defer posix.close(fds[1]);
+
+    var buf = EventBuffer.init(std.testing.allocator);
+    defer buf.deinit();
+
+    const big = "z" ** (form_inline_cap + 200);
+    try buf.pushForm(big);
+    try std.testing.expectEqual(@as(usize, big.len), buf.pendingBytes());
+    try std.testing.expectEqual(EventBuffer.FlushResult.drained, buf.flushTo(fds[1]));
+
+    var total: usize = 0;
+    var out: [form_inline_cap + 200]u8 = undefined;
+    while (total < big.len) {
+        const n = try posix.read(fds[0], out[total..]);
+        if (n == 0) break;
+        total += n;
+    }
+    try std.testing.expectEqual(@as(usize, big.len), total);
+}
+
+test "EventBuffer: dropToInflight with nothing sent clears all" {
+    var buf = EventBuffer.init(std.testing.allocator);
+    defer buf.deinit();
+
+    try buf.pushForm("(a)");
+    try buf.pushForm("(b)");
+    try buf.pushForm("(c)");
+    try std.testing.expectEqual(@as(usize, 3), buf.pendingForms());
+
+    buf.dropToInflight(); // head_off == 0 -> drop everything
+    try std.testing.expect(buf.isEmpty());
+    try std.testing.expectEqual(@as(usize, 0), buf.pendingBytes());
+}
